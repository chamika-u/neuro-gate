{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innova-x.local/neuro-gate/contracts/diagram-export/manifest.schema.json",
  "title": "Diagram Export Manifest",
  "description": "Committed record of the generated PNG set at neuro-gate/diagrams/manifest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "generated_at",
    "scale",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scale": {
      "type": "integer",
      "minimum": 2
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestEntry"
      }
    }
  },
  "$defs": {
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_name",
        "source_path",
        "origin",
        "content_hash",
        "width_px",
        "height_px",
        "size_bytes"
      ],
      "properties": {
        "output_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.png$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": ["standalone", "inline"]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "x-invariants": [
    "entries[].output_name values are unique",
    "entries[].content_hash values are unique",
    "entries are sorted ascending by output_name"
  ]
}
