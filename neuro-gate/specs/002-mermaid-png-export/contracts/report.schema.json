{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innova-x.local/neuro-gate/contracts/diagram-export/report.schema.json",
  "title": "Diagram Export Report",
  "description": "Machine-readable report emitted by export_diagrams.py --json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "generated_at",
    "docs_dir",
    "out_dir",
    "scale",
    "check_only",
    "total_discovered",
    "total_unique",
    "exported",
    "skipped",
    "failed",
    "diagrams",
    "success"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "docs_dir": {
      "type": "string",
      "minLength": 1
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": "integer",
      "minimum": 2
    },
    "check_only": {
      "type": "boolean"
    },
    "total_discovered": {
      "type": "integer",
      "minimum": 0
    },
    "total_unique": {
      "type": "integer",
      "minimum": 0
    },
    "exported": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "diagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/renderedDiagram"
      }
    },
    "success": {
      "type": "boolean"
    }
  },
  "$defs": {
    "renderedDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "output_name",
        "status",
        "scale"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.png$"
        },
        "status": {
          "type": "string",
          "enum": ["rendered", "skipped_duplicate", "failed"]
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "width_px": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "height_px": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "error": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["error"],
            "properties": { "error": { "type": "string", "minLength": 1 } }
          },
          "else": {
            "properties": { "error": { "type": "null" } }
          }
        }
      ]
    }
  }
}
