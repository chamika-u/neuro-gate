{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-gate.local/contracts/sanitized-intent.schema.json",
  "title": "SanitizedIntent",
  "description": "The only response shape accepted from the local semantic sanitizer. Anything else is a SILENT_DROP.",
  "contract_version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detected_language",
    "has_actionable_intent",
    "rejected_noise",
    "sanitized_text",
    "confidence"
  ],
  "properties": {
    "detected_language": {
      "type": "string",
      "enum": ["si-LK", "ta-LK", "en-US", "UNKNOWN"]
    },
    "has_actionable_intent": {
      "type": "boolean"
    },
    "rejected_noise": {
      "type": "array",
      "description": "Fragments removed because they are affective or non-actionable. Shown to the user locally for audit.",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "sanitized_text": {
      "type": "string",
      "maxLength": 500
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Composite score computed by the core, not trusted verbatim from the model."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "has_actionable_intent": { "const": true } } },
      "then": { "properties": { "sanitized_text": { "minLength": 1 } } }
    },
    {
      "if": { "properties": { "has_actionable_intent": { "const": false } } },
      "then": { "properties": { "sanitized_text": { "maxLength": 0 } } }
    }
  ]
}
